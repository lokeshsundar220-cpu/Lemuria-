PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lemuria_production?retryWrites=true&w=majority
DB_NAME=lemuria_production
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://lemuria-guest-portal-fajmniecm-lemuria4.vercel.app

