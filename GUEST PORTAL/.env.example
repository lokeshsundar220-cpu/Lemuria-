# Lemuria Guest Portal Environment Configuration

# In Production (e.g. Vercel):
# Set VITE_API_URL or VITE_API_BASE_URL to your deployed Render backend:
# VITE_API_URL=https://lemuria.onrender.com
# VITE_API_BASE_URL=https://lemuria.onrender.com/api

# In Local Development:
# VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
